# Ignorar node_modules en ambas carpetas
frontend/node_modules/
backend/node_modules/

# Ignorar archivos de entorno
frontend/.env
backend/.env

# Ignorar archivos de logs
frontend/npm-debug.log*
backend/npm-debug.log*
frontend/yarn-debug.log*
backend/yarn-debug.log*
frontend/yarn-error.log*
backend/yarn-error.log*

# Ignorar directorios de build o dist
frontend/build/
frontend/dist/
backend/build/
backend/dist/

# Ignorar archivos de configuración de IDEs
.vscode/
.idea/
*.swp

# Ignorar archivos de sistema
.DS_Store
Thumbs.db

# Ignorar volúmenes de Docker
docker-compose.override.yml
*.local

# Ignorar coverage (pruebas)
frontend/coverage/
backend/coverage/

# Ignorar lockfiles si no los usas en ambos entornos
# (opcional, dependiendo de tu flujo de trabajo)
frontend/package-lock.json
backend/package-lock.json
frontend/yarn.lock
backend/yarn.lock